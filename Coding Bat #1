  makeBricks
    public boolean makeBricks(int small, int big, int goal) {
      int x = goal/5;
      int y = 0;
      if(x>=big){
        y = goal - big*5;
      }else{
        y = goal - goal/5 * 5;
      }
      if(y<=small){
        return true;
      }else{
        return false;
      }
    }
  loneSum
    public int loneSum(int a, int b, int c) {
      int result = 0;
      if(a!=b && a!=c){
        result += a;
      }
      if(b!=a&&b!=c){
        result += b;
      }
      if(c!=b&&c!=a){
        result += c;
      }
      return result;
    }
