  starOut:
    public String starOut(String str) {
      String result = "";
      String left = "";
      String right = "";
      for(int i=0;i<str.length();i++){
        if(i!=0){
          left = str.substring(i-1,i);
        }
        String middle = str.substring(i,i+1);
        if(i+1 < str.length()){
          right = str.substring(i+1,i+2);
        }
        if((!left.equals("*")) && (!middle.equals("*")) && (!right.equals("*"))){
          result += middle;
        }
      }
  
    return result;
  }

  endOther:
    public boolean endOther(String a, String b) {
      a = a.toLowerCase();
      b = b.toLowerCase();
      String length = "";
      if(a.length() >= b.length()){
        length = a.substring(a.length() - b.length(), a.length());
        if(length.equals(b)){
          return true;
        }
      }else{
        length = b.substring(b.length() - a.length(), b.length());
        if(length.equals(a)){
          return true;
        }
      }
      return false;
    }
  


